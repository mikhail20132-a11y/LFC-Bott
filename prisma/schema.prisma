generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USER ────────────────────────────────────────────────────────────────────

model DiscordUser {
  id            String   @id @default(cuid())
  discordId     String   @unique
  username      String
  globalName    String?
  avatarUrl     String?
  joinedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  player        Player?
  teamsManaged  Team[]    @relation("TeamManager")
  refereedMatches Match[] @relation("MatchReferee")
  warnings      Warning[]
  suspensions   Suspension[]

  @@map("discord_users")
}

// ─── PLAYER ──────────────────────────────────────────────────────────────────

model Player {
  id            String   @id @default(cuid())
  lfcId         String   @unique
  discordId     String   @unique
  robloxUsername String?  // Roblox username for verification
  robloxId      String?   // Roblox user ID
  nickname      String?   // Auto-nickname assigned on contract
  position      String   // Goalkeeper, Defender, Midfielder, Forward
  region        String   // Europe, Asia, Africa, etc.
  joinedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          DiscordUser @relation(fields: [discordId], references: [discordId])
  teamId        String?
  team          Team?       @relation("TeamPlayers", fields: [teamId], references: [id])
  roleInTeam    String?     // Captain, Vice Captain, Starter, Sub, Academy

  // Career stats
  goals         Int      @default(0)
  assists       Int      @default(0)
  saves         Int      @default(0)   // Goalkeeper specific
  mvps          Int      @default(0)
  appearances   Int      @default(0)
  yellowCards   Int      @default(0)
  redCards      Int      @default(0)
  cleanSheets   Int      @default(0)   // Goalkeeper specific

  trophies      Int      @default(0)
  awards        Award[]

  // Season-specific stats
  seasonStats   PlayerSeasonStats[]

  // Match participation
  matchGoals    MatchGoal[]
  matchAssists  MatchAssist[]
  matchMvps     MatchMvp[]

  // Contract & transfer history
  contracts     Contract[]
  transfersFrom Transfer[] @relation("FromPlayer")

  // Lineup participation
  lineups       LineupPlayer[]
  matchCards    MatchCard[]
  weeklyAwards  WeeklyAward[]
  motmVotes     MotmVote[]

  @@map("players")
}

model PlayerSeasonStats {
  id          String @id @default(cuid())
  playerId    String
  seasonId    String
  goals       Int    @default(0)
  assists     Int    @default(0)
  saves       Int    @default(0)
  mvps        Int    @default(0)
  appearances Int    @default(0)
  yellowCards Int    @default(0)
  redCards    Int    @default(0)
  cleanSheets Int    @default(0)

  player      Player @relation(fields: [playerId], references: [id])
  season      Season @relation(fields: [seasonId], references: [id])

  @@unique([playerId, seasonId])
  @@map("player_season_stats")
}

// ─── TEAM ────────────────────────────────────────────────────────────────────

model Team {
  id            String      @id @default(cuid())
  name          String      @unique
  shortName     String?     // e.g. "LFC"
  logoUrl       String?
  emoji         String?     // Team emoji (e.g. "⚽")
  description   String?
  roleId        String?     // Discord role ID for the team
  managerId     String
  manager       DiscordUser @relation("TeamManager", fields: [managerId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  players       Player[]    @relation("TeamPlayers")

  // Season records
  seasonTeams   TeamSeasonStats[]

  // Home and away matches
  homeMatches   Match[]     @relation("HomeTeam")
  awayMatches   Match[]     @relation("AwayTeam")

  contracts     Contract[]
  lineups       Lineup[]

  trophies      Int         @default(0)

  @@map("teams")
}

model TeamSeasonStats {
  id          String  @id @default(cuid())
  teamId      String
  seasonId    String
  played      Int     @default(0)
  wins        Int     @default(0)
  draws       Int     @default(0)
  losses      Int     @default(0)
  goalsFor    Int     @default(0)
  goalsAgainst Int    @default(0)
  points      Int     @default(0)

  team        Team    @relation(fields: [teamId], references: [id])
  season      Season  @relation(fields: [seasonId], references: [id])

  @@unique([teamId, seasonId])
  @@map("team_season_stats")
}

// ─── SEASON ──────────────────────────────────────────────────────────────────

model Season {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Season 1", "Season 2"
  isActive    Boolean  @default(false)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  matches      Match[]
  playerStats  PlayerSeasonStats[]
  teamStats    TeamSeasonStats[]
  awards       Award[]
  weeklyAwards WeeklyAward[]

  @@map("seasons")
}

// ─── MATCH ───────────────────────────────────────────────────────────────────

model Match {
  id          String   @id @default(cuid())
  matchNumber Int?
  matchweek   Int?      // Week/fixture number
  homeTeamId  String
  awayTeamId  String
  homeScore   Int      @default(0)
  awayScore   Int      @default(0)
  status      String   @default("Scheduled") // Scheduled, Live, Finished, Postponed, Forfeit
  matchDate   DateTime?
  refereeId   String?
  referee     DiscordUser? @relation("MatchReferee", fields: [refereeId], references: [id])
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id])
  threadId    String?   // Discord thread ID for live match
  forfeit     Boolean  @default(false)
  forfeitingTeam String? // "home" or "away" — who forfeited
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homeTeam    Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])

  goals       MatchGoal[]
  assists     MatchAssist[]
  mvps        MatchMvp[]
  cards       MatchCard[]
  lineups     Lineup[]
  lineupsP    LineupPlayer[]
  disputes    Dispute[]
  predictions Prediction[]
  motmPoll    MotmPoll[]

  @@map("matches")
}

model MatchGoal {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  minute   Int?
  isOwnGoal Boolean @default(false)

  match    Match  @relation(fields: [matchId], references: [id])
  player   Player @relation(fields: [playerId], references: [id])

  @@map("match_goals")
}

model MatchAssist {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  minute   Int?

  match    Match  @relation(fields: [matchId], references: [id])
  player   Player @relation(fields: [playerId], references: [id])

  @@map("match_assists")
}

model MatchMvp {
  id       String @id @default(cuid())
  matchId  String @unique
  playerId String
  reason   String?

  match    Match  @relation(fields: [matchId], references: [id])
  player   Player @relation(fields: [playerId], references: [id])

  @@map("match_mvps")
}

model MatchCard {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  type     String // Yellow, Red
  minute   Int?
  reason   String?

  match    Match  @relation(fields: [matchId], references: [id])
  player   Player @relation(fields: [playerId], references: [id])

  @@map("match_cards")
}

// ─── AWARD ───────────────────────────────────────────────────────────────────

model Award {
  id        String   @id @default(cuid())
  type      String   // Golden Boot, Golden Boy, Best Playmaker, etc.
  playerId  String
  seasonId  String
  reason    String?
  awardedAt DateTime @default(now())

  player    Player   @relation(fields: [playerId], references: [id])
  season    Season   @relation(fields: [seasonId], references: [id])

  @@unique([playerId, seasonId, type])
  @@map("awards")
}

// ─── TRANSFER ────────────────────────────────────────────────────────────────

model Transfer {
  id            String   @id @default(cuid())
  playerId      String
  fromTeamId    String?
  toTeamId      String?
  fromTeamName  String?
  toTeamName    String?
  fee           Int?     // Transfer fee (in millions or currency unit)
  status        String   @default("Pending") // Pending, Completed, Cancelled
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  player        Player   @relation("FromPlayer", fields: [playerId], references: [id])

  @@map("transfers")
}

// ─── WARNINGS & SUSPENSIONS ──────────────────────────────────────────────────

model Warning {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  issuedBy  String   // Discord ID of who issued
  createdAt DateTime @default(now())

  user      DiscordUser @relation(fields: [userId], references: [id])

  @@map("warnings")
}

model Suspension {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  issuedBy  String
  expiresAt DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      DiscordUser @relation(fields: [userId], references: [id])

  @@map("suspensions")
}

model Blacklist {
  id        String   @id @default(cuid())
  discordId String   @unique
  reason    String
  issuedBy  String
  createdAt DateTime @default(now())

  @@map("blacklist")
}

// ─── GUILD CONFIG ────────────────────────────────────────────────────────────

model GuildConfig {
  id          String   @id @default(cuid())
  guildId     String   @unique
  newsChannelId String?
  staffRoleId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("guild_config")
}

// ─── NEWS / ANNOUNCEMENTS ────────────────────────────────────────────────────

model NewsArticle {
  id        String   @id @default(cuid())
  guildId   String
  type      String   // match_result, transfer, award, season, milestone, broadcast
  title     String
  content   String   @db.Text
  imageUrl  String?
  messageId String?
  channelId String?
  createdAt DateTime @default(now())

  @@map("news_articles")
}

// ─── CONTRACT ────────────────────────────────────────────────────────────────

model Contract {
  id            String   @id @default(cuid())
  playerId      String
  teamId        String
  teamName      String   @default("")
  roleInTeam    String?  // Captain, Vice Captain, Starter, Sub, Academy
  signedAt      DateTime @default(now())
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  player        Player   @relation(fields: [playerId], references: [id])
  team          Team     @relation(fields: [teamId], references: [id])

  @@map("contracts")
}

// ─── LINEUP ──────────────────────────────────────────────────────────────────

model Lineup {
  id            String   @id @default(cuid())
  matchId       String
  teamId        String
  captainId     String?
  formation     String?  // e.g. "4-4-2", "4-3-3"
  submittedAt   DateTime @default(now())
  isConfirmed   Boolean  @default(false)

  match         Match    @relation(fields: [matchId], references: [id])
  team          Team     @relation(fields: [teamId], references: [id])
  players       LineupPlayer[]

  @@map("lineups")
}

model LineupPlayer {
  id       String  @id @default(cuid())
  lineupId String
  playerId String
  matchId  String
  position String? // The position in the lineup (GK, LB, CB, CM, ST, etc.)
  isBench  Boolean @default(false)
  order    Int     @default(0) // Display order

  lineup   Lineup  @relation(fields: [lineupId], references: [id])
  player   Player  @relation(fields: [playerId], references: [id])
  match    Match   @relation(fields: [matchId], references: [id])

  @@map("lineup_players")
}

// ─── DISPUTE ─────────────────────────────────────────────────────────────────

model Dispute {
  id            String   @id @default(cuid())
  matchId       String
  reporterId    String   // Discord ID
  reason        String   @db.Text
  evidenceUrl   String?  // Link to clip/screenshot evidence
  status        String   @default("Open") // Open, Under Review, Resolved, Dismissed
  resolvedBy    String?  // Discord ID of who resolved
  resolution    String?  // Resolution notes
  ticketChannelId String? // Discord channel ID for the ticket
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  match         Match    @relation(fields: [matchId], references: [id])

  @@map("disputes")
}

// ─── PREDICTION ──────────────────────────────────────────────────────────────

model Prediction {
  id              String   @id @default(cuid())
  matchId         String
  userId          String   // Discord ID of predictor
  predictedTeamId String   // Which team they predict will win (or null for draw)
  predictedDraw   Boolean  @default(false)
  points          Int      @default(0)
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  match           Match    @relation(fields: [matchId], references: [id])

  @@unique([matchId, userId])
  @@map("predictions")
}

// ─── WEEKLY AWARDS ──────────────────────────────────────────────────────────

model WeeklyAward {
  id          String   @id @default(cuid())
  type        String   // potw (Player of Week), totw (Team of Week)
  playerId    String?
  teamId      String?
  seasonId    String
  weekNumber  Int
  reason      String?
  awardedAt   DateTime @default(now())

  season      Season   @relation(fields: [seasonId], references: [id])
  player      Player?  @relation(fields: [playerId], references: [id])

  @@map("weekly_awards")
}

// ─── MOTM (Man of the Match) Poll ───────────────────────────────────────────

model MotmPoll {
  id        String   @id @default(cuid())
  matchId   String   @unique
  messageId String?  // Discord message ID of the poll
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  match     Match    @relation(fields: [matchId], references: [id])
  votes     MotmVote[]

  @@map("motm_polls")
}

model MotmVote {
  id        String   @id @default(cuid())
  pollId    String
  voterId   String   // Discord ID of voter
  playerId  String   // Player they voted for
  createdAt DateTime @default(now())

  poll      MotmPoll @relation(fields: [pollId], references: [id])
  player    Player   @relation(fields: [playerId], references: [id])

  @@unique([pollId, voterId])
  @@map("motm_votes")
}

// ─── WAITLIST ────────────────────────────────────────────────────────────────

model WaitlistEntry {
  id        String   @id @default(cuid())
  guildId   String
  discordId String
  username  String
  position  String
  region    String
  note      String?
  addedAt   DateTime @default(now())

  @@unique([guildId, discordId])
  @@map("waitlist_entries")
}